{
  "config": "cfg/example_inference_config.yaml",
  "run": {
    "mode": "batch",
    "runtime": "main"
  },
  "clock": {
    "timestep": "constant",
    "termination": "number_of_steps"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "output",
      "declared_in": "outputs",
      "condition": "every_step",
      "sink": "stdout",
      "location": "stdout"
    }
  ],
  "embedded": [
    {
      "partition": "ornstein_uhlenbeck_simulation",
      "depth": 1,
      "termination": "number_of_steps",
      "steps": 200,
      "steps_per_run_step": 200,
      "columns": [
        {
          "partition": "data_rolling_mean_copy",
          "offset": 0,
          "width": 4
        },
        {
          "partition": "data_rolling_cov_copy",
          "offset": 4,
          "width": 16
        },
        {
          "partition": "simulation_iteration",
          "offset": 20,
          "width": 4
        },
        {
          "partition": "data_comparison_to_simulation",
          "offset": 24,
          "width": 1
        }
      ]
    }
  ]
}
