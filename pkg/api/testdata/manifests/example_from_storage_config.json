{
  "config": "cfg/example_from_storage_config.yaml",
  "run": {
    "mode": "batch",
    "runtime": "main"
  },
  "clock": {
    "timestep": "from_input",
    "timestep_input": "from_storage/timestep_function",
    "termination": "number_of_steps"
  },
  "inputs": [
    {
      "name": "from_storage/clear_sky_driver",
      "kind": "inline",
      "partitions": [
        "clear_sky_driver"
      ],
      "read_by": [
        "main.partitions[name=clear_sky_driver]"
      ]
    },
    {
      "name": "from_storage/timestep_function",
      "kind": "inline",
      "read_by": [
        "main.simulation.timestep_function"
      ]
    }
  ],
  "outputs": [
    {
      "name": "output",
      "declared_in": "outputs",
      "condition": "every_step",
      "sink": "stdout",
      "location": "stdout"
    }
  ]
}
