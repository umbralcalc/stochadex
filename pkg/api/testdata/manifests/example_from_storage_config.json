{
  "config": "cfg/example_from_storage_config.yaml",
  "run": {
    "mode": "batch",
    "runtime": "main"
  },
  "clock": {
    "timestep": "from_storage",
    "termination": "number_of_steps"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "output",
      "declared_in": "main.simulation",
      "condition": "every_step",
      "sink": "stdout",
      "location": "stdout"
    }
  ]
}
