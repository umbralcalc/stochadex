{
  "config": "cfg/example_state_space_count_config.yaml",
  "run": {
    "mode": "batch",
    "runtime": "macros",
    "macros": [
      "smc_inference"
    ]
  },
  "inputs": [
    {
      "name": "data",
      "kind": "simulation",
      "read_by": [
        "macros"
      ]
    }
  ],
  "outputs": [
    {
      "name": "output",
      "declared_in": "default",
      "condition": "every_step",
      "sink": "stdout",
      "location": "stdout"
    }
  ]
}
