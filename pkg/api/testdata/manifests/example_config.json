{
  "config": "cfg/example_config.yaml",
  "run": {
    "mode": "batch",
    "runtime": "main"
  },
  "clock": {
    "timestep": "constant",
    "termination": "number_of_steps"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "output",
      "declared_in": "outputs",
      "condition": "every_step",
      "sink": "json_log",
      "location": "./nbs/data/test.log"
    }
  ]
}
