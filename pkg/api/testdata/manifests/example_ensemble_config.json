{
  "config": "cfg/example_ensemble_config.yaml",
  "run": {
    "mode": "ensemble",
    "runtime": "main",
    "seeds": [
      11,
      22,
      33,
      44
    ]
  },
  "clock": {
    "timestep": "constant",
    "termination": "number_of_steps"
  },
  "inputs": [],
  "outputs": [
    {
      "name": "output",
      "declared_in": "main.simulation",
      "condition": "every_step",
      "sink": "stdout",
      "location": "stdout"
    }
  ]
}
